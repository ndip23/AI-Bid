{
  "name": "ai-bid-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered SaaS platform for discovering, evaluating, scoring, and tracking procurement opportunities",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm --prefix apps/backend run start:dev",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "build:backend": "npm --prefix apps/backend run build",
    "build:frontend": "npm --prefix apps/frontend run build",
    "prisma:generate": "npm --prefix apps/backend run prisma:generate",
    "prisma:seed": "npm --prefix apps/backend run prisma:seed"
  },
  "keywords": [
    "saas",
    "procurement",
    "tenders",
    "ai",
    "bid-copilot",
    "nestjs",
    "nextjs"
  ],
  "author": "AI Bid Copilot Team",
  "license": "MIT",
  "dependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.2.0",
    "@prisma/client": "^5.9.0",
    "axios": "^1.6.5",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.0.0-rc.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.10.0",
    "combined-stream": "^1.0.8",
    "form-data": "^4.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "xml2js": "^0.6.2"
  }
}
