# Bidora — Environment Configuration
# Copy this file to apps/backend/.env and add your live keys
# For frontend, copy NEXT_PUBLIC_API_URL to apps/frontend/.env.local

# ─── 1. PostgreSQL Database (Free Hosting Recommendation: Neon) ───────────────
# Recommended Free Tier Host: Neon (https://neon.tech)
# - Completely FREE 10GB serverless PostgreSQL database (No credit card needed)
# - Scales automatically as your SaaS grows with zero subscription cost
# Example Neon connection string formats:
# Pooled (for DATABASE_URL):
# DATABASE_URL="postgresql://user:password@ep-cool-name-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct / Unpooled (for DIRECT_URL migrations):
# DIRECT_URL="postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgrespassword2026@localhost:5432/bidora_db?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword2026@localhost:5432/bidora_db?schema=public"

# ─── 2. Google Gemini API (Free AI Key via Google AI Studio) ──────────────────
# Get your FREE key at: https://aistudio.google.com/app/apikey
# Uses Gemini 1.5 Flash for high-speed tender summarization & eligibility analysis
GEMINI_API_KEY=""

# Optional Secondary OpenAI Fallback Key (https://platform.openai.com)
OPENAI_API_KEY=""

# ─── 3. Cloudinary (Free Image & Document CDN) ─────────────────────────────────
# Get your FREE Cloudinary credentials at: https://cloudinary.com (25GB Free Storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── 4. Auth & Application Config ─────────────────────────────────────────────
JWT_SECRET="ai-bid-copilot-jwt-super-secret-key-2026"
JWT_EXPIRES_IN="7d"
PORT="4000"
NODE_ENV="production"
CORS_ORIGIN="http://localhost:3000,https://bidora.vercel.app"

# ─── 5. Redis (for background queues & caching) ────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ─── 6. Frontend Environment ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# ─── 7. Ingestion Engine & Source Toggles ─────────────────────────────────────
ENABLE_SAMPLE_DATA="false"
WORLD_BANK_API_ENABLED="true"
UNGM_API_ENABLED="true"
AFDB_API_ENABLED="true"
ARMP_SCRAPER_ENABLED="true"
COLEPS_SCRAPER_ENABLED="true"
GENERIC_CRAWLER_ENABLED="true"
