# AI Bid Copilot — Environment Configuration
# Copy this file to apps/backend/.env and add your live keys

# ─── 1. PostgreSQL Database (Free Hosting Recommendation: Neon) ───────────────
# Recommended Free Tier Host: Neon (https://neon.tech)
# - Completely FREE 10GB serverless PostgreSQL database (No credit card needed)
# - Scales automatically as your SaaS grows with zero subscription cost
# Example Neon connection string format:
# DATABASE_URL="postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgrespassword2026@localhost:5432/aibidcopilot?schema=public"

# ─── 2. Google Gemini API (Free AI Key via Google AI Studio) ──────────────────
# Get your FREE key at: https://aistudio.google.com/app/apikey
# Uses Gemini 1.5 Flash for high-speed tender summarization & eligibility analysis
GEMINI_API_KEY=""

# Optional Secondary OpenAI Fallback Key (https://platform.openai.com)
OPENAI_API_KEY=""

# ─── 3. Cloudinary (Free Image & Document CDN) ─────────────────────────────────
# Get your FREE Cloudinary credentials at: https://cloudinary.com (25GB Free Storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── 4. Auth & Application Config ─────────────────────────────────────────────
JWT_SECRET="ai-bid-copilot-jwt-super-secret-key-2026"
JWT_EXPIRES_IN="7d"
PORT="4000"
NODE_ENV="development"

# ─── 5. Redis (for background BullMQ queues) ──────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT="6379"
