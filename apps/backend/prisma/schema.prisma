generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_USER
}

enum SavedStatus {
  BOOKMARKED
  UNDER_REVIEW
  BIDDING
  PASSED
}

enum TenderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum OrganizationType {
  NATIONAL_PROCUREMENT_AUTHORITY
  MINISTRY
  GOVERNMENT_AGENCY
  PUBLIC_UNIVERSITY
  TEACHING_HOSPITAL
  REGIONAL_COUNCIL
  MUNICIPALITY
  STATE_OWNED_ENTERPRISE
  DEVELOPMENT_PROJECT
  INTERNATIONAL_ORGANIZATION
  DEVELOPMENT_BANK
  NGO
  PRIVATE_PROCUREMENT
}

enum ConnectorType {
  REST_API
  RSS
  HTML
  PDF
  XML
  CSV
  MANUAL_UPLOAD
}

enum AuthenticationType {
  NONE
  API_KEY
  BEARER_TOKEN
  BASIC_AUTH
  SESSION_COOKIE
}

enum PublisherStatus {
  ACTIVE
  PAUSED
  FAILED
  DISCOVERING
  AUTH_REQUIRED
}

enum OpportunityType {
  PUBLIC_TENDER
  PRIVATE_TENDER
  REQUEST_FOR_QUOTATION
  REQUEST_FOR_PROPOSAL
  REQUEST_FOR_INFORMATION
  EXPRESSION_OF_INTEREST
  SUBCONTRACTING
  SUPPLIER_REQUEST
  VENDOR_REGISTRATION
  BUSINESS_OPPORTUNITY
  PARTNERSHIP_OPPORTUNITY
  DONOR_PROCUREMENT
  OTHER
}

enum SourceCategory {
  GOVERNMENT
  STATE_OWNED_ENTERPRISE
  PRIVATE_PROCUREMENT
  SUBCONTRACTING
  NGO_PROCUREMENT
  DONOR_PROCUREMENT
  UNIVERSITY
  HEALTHCARE
  MUNICIPAL
  OTHER
}

enum BuyerType {
  GOVERNMENT
  STATE_OWNED_ENTERPRISE
  PRIVATE_COMPANY
  NGO
  UNIVERSITY
  HOSPITAL
}

enum BuyerIntent {
  BUY
  HIRE
  OUTSOURCE
  SUBCONTRACT
  PARTNER
  SUPPLY
  CONSULT
  CONSTRUCT
  MAINTAIN
  REGISTER_VENDOR
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  username     String?        @unique
  role         UserRole       @default(COMPANY_USER)
  companyId    String?
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  notifications Notification[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("users")
}

model Company {
  id             String         @id @default(uuid())
  name           String
  taxId          String?
  industry       String
  countries      String[]       // List of operational countries e.g. ["Cameroon", "Nigeria", "Kenya"]
  certifications String[]       // List of certifications e.g. ["ISO 27001", "SOC 2 Type II", "ISO 9001"]
  services       String[]       // Key capabilities/services e.g. ["Cloud Migration", "Cybersecurity", "Custom Software"]
  annualRevenue  String?        // e.g. "$10M - $50M"
  teamSize       Int            @default(10)
  website        String?
  description    String?        @db.Text
  users          User[]
  savedTenders   SavedTender[]
  matchScores    MatchScore[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("companies")
}

model Publisher {
  id                  String             @id @default(uuid())
  country             String             // e.g. "Cameroon", "Nigeria", "Kenya", "Ghana"
  name                String             // e.g. "ARMP Cameroon", "Federal Ministry of Works Nigeria"
  organizationType    OrganizationType   @default(GOVERNMENT_AGENCY)
  officialWebsite     String?
  procurementPage     String?
  tendersPage         String?
  newsPage            String?
  projectsPage        String?
  rssFeed             String?
  apiEndpoint         String?
  connectorType       ConnectorType      @default(HTML)
  authenticationType  AuthenticationType @default(NONE)
  crawlInterval       Int                @default(60) // in minutes
  status              PublisherStatus    @default(ACTIVE)
  sourceCategory      SourceCategory?    @default(GOVERNMENT)
  defaultBuyerType    BuyerType?         @default(GOVERNMENT)
  requiresAuth        Boolean            @default(false)
  qualityScore        Int                @default(80)
  averageDailyYield   Float              @default(0)
  uniqueRate          Float              @default(0)
  lastSuccessfulSync  DateTime?
  lastFailedSync      DateTime?
  parserConfiguration Json?              // Selectors, endpoints mapping, pagination settings
  tenders             Tender[]
  syncLogs            SyncLog[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@map("publishers")
}

model SyncLog {
  id                 String        @id @default(uuid())
  publisherId        String
  publisher          Publisher     @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  country            String
  connectorType      ConnectorType
  startTime          DateTime      @default(now())
  endTime            DateTime?
  recordsRetrieved   Int           @default(0)
  newRecords         Int           @default(0)
  updatedRecords     Int           @default(0)
  duplicates         Int           @default(0)
  failedRecords      Int           @default(0)
  documentsDownloaded Int          @default(0)
  errors             Json?
  createdAt          DateTime      @default(now())

  @@map("sync_logs")
}

model Tender {
  id                 String           @id @default(uuid())
  title              String
  refNumber          String           @unique
  buyerName          String
  buyerCountry       String
  industry           String
  estimatedValue     Float
  currency           String           @default("USD")
  publishDate        DateTime
  deadline           DateTime
  description        String           @db.Text
  rawContent         String           @db.Text
  status             TenderStatus     @default(OPEN)
  sourceUrl          String?
  attachments        String[]         // Array of S3 URLs / document paths
  publisherId        String?
  publisher          Publisher?       @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  organization       String?
  sector             String?
  subcategory        String?
  procurementMethod  String?
  openingDate        DateTime?
  contactInformation Json?
  language           String           @default("en")
  opportunityType    OpportunityType?
  sourceCategory     SourceCategory?
  buyerType          BuyerType?
  buyerIntent        BuyerIntent?
  fundingOrganization String?
  projectName        String?
  projectId          String?
  implementingAgency String?
  region             String?
  city               String?
  eligibility        Json?
  sourceQualityScore Int?             @default(80)
  originalSource     String?
  originalUrl        String?
  originalExternalId String?
  aiSummary          AiSummary?
  savedTenders       SavedTender[]
  matchScores        MatchScore[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("tenders")
}

model ProcurementSource {
  id            String    @id @default(uuid())
  country       String    // Legacy support table
  sourceName    String
  method        String
  frequency     String
  status        String    @default("ACTIVE")
  lastSyncAt    DateTime? @default(now())
  totalIngested Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("procurement_sources")
}

model SavedTender {
  id        String      @id @default(uuid())
  companyId String
  tenderId  String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tender    Tender      @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  status    SavedStatus @default(BOOKMARKED)
  priority  Priority    @default(MEDIUM)
  notes     String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([companyId, tenderId])
  @@map("saved_tenders")
}

model AiSummary {
  id               String   @id @default(uuid())
  tenderId         String   @unique
  tender           Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  executiveSummary String   @db.Text
  requirements     Json     // List of extracted key requirements with mandatory flag
  deliverables     Json     // Expected deliverables and scope items
  deadlineSummary  String
  risks            Json     // List of identified risks, severity, and mitigation suggestions
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("ai_summaries")
}

model MatchScore {
  id                  String   @id @default(uuid())
  companyId           String
  tenderId            String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tender              Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  overallScore        Int      // 0 to 100 percentage
  industryMatchScore  Int      // 0 to 100
  countryMatchScore   Int      // 0 to 100
  experienceScore     Int      // 0 to 100
  certMatchScore      Int      // 0 to 100
  reasons             Json     // Detailed match breakdown reasons
  metRequirements     Json     // Array of matched eligibility requirements
  missingRequirements Json     // Array of missing/unmet eligibility requirements
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("match_scores")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // "NEW_MATCH", "DEADLINE_WARNING", "STATUS_CHANGE"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model SubcontractorProfile {
  id              String   @id @default(uuid())
  companyName     String
  country         String   @default("Cameroon")
  sector          String
  subsector       String?
  location        String?
  contactPerson   String?
  email           String?
  phone           String?
  website         String?
  certifications  String[]
  services        String[]
  source          String   @default("BSTP-CMR")
  sourceUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("subcontractor_profiles")
}
