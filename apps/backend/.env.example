DATABASE_URL="postgresql://user:password@localhost:5432/aibid?sslmode=prefer"
PORT=4000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

REDIS_HOST=localhost
REDIS_PORT=6379

GEMINI_API_KEY=
OPENAI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Procurement Ingestion Switches & API Credentials
ENABLE_SAMPLE_DATA=false
WORLD_BANK_API_ENABLED=true

UNGM_API_ENABLED=true
UNGM_CLIENT_ID=your_ungm_client_id_here
UNGM_CLIENT_SECRET=your_ungm_client_secret_here

AFDB_API_ENABLED=true
ARMP_SCRAPER_ENABLED=true
COLEPS_SCRAPER_ENABLED=true
GENERIC_CRAWLER_ENABLED=true
